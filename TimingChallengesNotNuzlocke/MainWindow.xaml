<Window x:Class="TimingChallengesNotNuzlocke.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TimingChallengesNotNuzlocke"
        mc:Ignorable="d"
        Title="Timing Challenges Overlay" Height="450" Width="1000"  MinHeight="450" MinWidth="1000">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Label Content="Breath of the Wild Challenges" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Top" Grid.ColumnSpan="2"/>
        <Label Content="Active Rules" Margin="28,48,0,0" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Top"/>

        <ListBox x:Name="activeRulesList" Grid.Row="1" Grid.Column="0" d:ItemsSource="{d:SampleData ItemCount=3}" Margin="10,40,10,120">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Action}" Margin="2"/>
                        <TextBlock Text="{Binding Consequence}" Margin="2"/>
                        <TextBlock Text=" for " Margin="2"/>
                        <TextBlock Text="{Binding FormattedTimeLimit}" Margin="2"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <UniformGrid Grid.Row="1" Grid.Column="0" Columns="2" VerticalAlignment="Bottom" Margin="10,0,10,10">
            <Button Content="_Start Challenge" HorizontalAlignment="Left" Padding="10,5" Margin="3" VerticalAlignment="Top"  ToolTip="Starts all challenge timers." IsDefault="True" Click="ButtonStartChallenge"/>
            <Button Content="_Pause All Timers" HorizontalAlignment="Left" Padding="10,5" Margin="3" VerticalAlignment="Top"  ToolTip="Pause or unpause all active challenge timers." Click="ButtonPauseTimers"/>
            <Button Content="_Change Last Rule" HorizontalAlignment="Left" Padding="10,5" Margin="3" VerticalAlignment="Top" ToolTip="Reroll the action and consequence of the newest rule." Click="ButtonChangeLastRule"/>
            <Button Content="_End Challenge" HorizontalAlignment="Left" Padding="10,5" Margin="3" VerticalAlignment="Top" Click="CloseApplication" IsCancel="True" ToolTip="Reroll the action and consequence of the newest rule."/>
        </UniformGrid>

        <Border BorderBrush="Black" BorderThickness="1" Grid.Row="1" Grid.Column="1" Margin="10,10,10,10"/>

    </Grid>
</Window>
